# SentiScope AI — Environment Configuration Example

# API Configuration
API_V1_PREFIX=/api/v1
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=false

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# Database
DATABASE_URL=sqlite:///./backend/sentiscope.db

# ML Model Settings
DEFAULT_MODEL_ID=tfidf-logreg
MODEL_REGISTRY_PATH=./artifacts/models

